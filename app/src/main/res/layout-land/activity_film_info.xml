<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ImageView
        android:id="@+id/film_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="200dp"
        android:alpha="0.45"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ScrollView
        android:id="@+id/film_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingTop="40dp"
            android:paddingEnd="56dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/film_poster"
                android:layout_width="180dp"
                android:layout_height="270dp"
                android:background="@color/film_poster_empty"
                android:contentDescription="@null"
                android:elevation="6dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/film_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/film_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/film_genres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp" />

                <!-- the same parts as the upright page; FilmInfoActivity finds them in both -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/film_ratings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/film_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/film_confirm_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/film_confirm_change"
                            style="@style/FilmInfoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="88dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="@string/film_confirm_change"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/film_confirm_yes"
                            style="@style/FilmInfoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:minWidth="88dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="@string/film_confirm_yes"
                            android:textSize="14sp" />

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/film_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="4dp"
                    android:maxWidth="620dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/film_cast_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/film_cast"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/film_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/film_cast_list"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <ProgressBar
                    android:id="@+id/film_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="320dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="18dp"
                    android:max="1000" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/film_resume"
                        style="@style/FilmInfoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp" />

                    <TextView
                        android:id="@+id/film_start"
                        style="@style/FilmInfoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/film_play_start" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/film_file"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/film_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <!-- under the file, not in the row above: four buttons do not fit across -->
                <TextView
                    android:id="@+id/film_copy_link"
                    style="@style/FilmInfoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/film_copy_link"
                    android:visibility="gone" />

                <!-- its own line too: its words wrap in a row on a phone on its side -->
                <TextView
                    android:id="@+id/film_change"
                    style="@style/FilmInfoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/film_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/film_back_circle"
        android:contentDescription="@string/film_back"
        android:src="@drawable/ic_arrow_back_24dp"
        android:tint="@android:color/white" />

</FrameLayout>
