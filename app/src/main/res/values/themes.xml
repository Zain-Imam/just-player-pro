<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/ui_controls_background</item>
        <item name="android:navigationBarColor">@color/ui_controls_background</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <!-- AppCompat reads colorAccent; the framework one is set for platform dialogs -->
        <item name="accentColor">@color/accent_orange</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
    </style>

    <style name="Theme.Player" parent="BaseTheme.Player">
    </style>

    <!-- DayNight, so the home screen follows the device between light and dark -->
    <style name="Theme.Player.Home" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="accentColor">@color/accent_orange</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
    </style>

    <!-- the preference widgets need an AppCompat DayNight theme -->
    <style name="Theme.Player.Settings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="accentColor">@color/accent_orange</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
    </style>

    <!-- slides in from the side so the film stays visible -->
    <style name="PanelAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/panel_in</item>
        <item name="android:windowExitAnimation">@anim/panel_out</item>
    </style>

    <style name="ExoStyledControls.Button.Center.Secondary" parent="ExoStyledControls.Button.Center">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Transparent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="MediaStoreChooserDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item> <!-- When focused, line scrolls -->
    </style>

    <!-- accent overlays, applied at runtime with Theme.applyStyle -->
    <style name="Accent.Red" parent=""><item name="accentColor">@color/accent_red</item><item name="colorAccent">@color/accent_red</item><item name="android:colorAccent">@color/accent_red</item></style>
    <style name="Accent.Orange" parent=""><item name="accentColor">@color/accent_orange</item><item name="colorAccent">@color/accent_orange</item><item name="android:colorAccent">@color/accent_orange</item></style>
    <style name="Accent.Yellow" parent=""><item name="accentColor">@color/accent_yellow</item><item name="colorAccent">@color/accent_yellow</item><item name="android:colorAccent">@color/accent_yellow</item></style>
    <style name="Accent.Lime" parent=""><item name="accentColor">@color/accent_lime</item><item name="colorAccent">@color/accent_lime</item><item name="android:colorAccent">@color/accent_lime</item></style>
    <style name="Accent.Green" parent=""><item name="accentColor">@color/accent_green</item><item name="colorAccent">@color/accent_green</item><item name="android:colorAccent">@color/accent_green</item></style>
    <style name="Accent.Cyan" parent=""><item name="accentColor">@color/accent_cyan</item><item name="colorAccent">@color/accent_cyan</item><item name="android:colorAccent">@color/accent_cyan</item></style>
    <style name="Accent.Blue" parent=""><item name="accentColor">@color/accent_blue</item><item name="colorAccent">@color/accent_blue</item><item name="android:colorAccent">@color/accent_blue</item></style>
    <style name="Accent.Violet" parent=""><item name="accentColor">@color/accent_violet</item><item name="colorAccent">@color/accent_violet</item><item name="android:colorAccent">@color/accent_violet</item></style>
    <style name="Accent.Fuchsia" parent=""><item name="accentColor">@color/accent_fuchsia</item><item name="colorAccent">@color/accent_fuchsia</item><item name="android:colorAccent">@color/accent_fuchsia</item></style>
    <style name="Accent.Pink" parent=""><item name="accentColor">@color/accent_pink</item><item name="colorAccent">@color/accent_pink</item><item name="android:colorAccent">@color/accent_pink</item></style>
    <style name="Accent.Slate" parent=""><item name="accentColor">@color/accent_slate</item><item name="colorAccent">@color/accent_slate</item><item name="android:colorAccent">@color/accent_slate</item></style>
</resources>
