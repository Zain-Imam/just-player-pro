<?xml version="1.0" encoding="utf-8"?>
<!-- Brand-filled when focused so a remote user can see it is selected; a dark
     translucent pill otherwise, which stays legible over any frame. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentColor" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentColor" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC1A1A1A" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
