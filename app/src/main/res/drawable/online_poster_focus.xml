<?xml version="1.0" encoding="utf-8"?>
<!-- The focus ring for the poster grid.

     A television has no cursor, so the only way to know which poster is selected
     is that it is drawn differently. The brand-coloured border plus a lifted
     background is deliberately heavy: at three metres a subtle outline is no
     outline at all. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="3dp" android:color="?attr/accentColor" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="3dp" android:color="?attr/accentColor" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <stroke android:width="2dp" android:color="?attr/accentColor" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
