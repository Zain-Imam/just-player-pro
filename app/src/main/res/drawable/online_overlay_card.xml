<?xml version="1.0" encoding="utf-8"?>
<!-- Half transparent, so the picture stays readable behind the card rather than
     being boxed out of its own frame. The centre play button is hidden while the
     card is up, so nothing ghosts through the text.

     Rounded so it reads as a card rather than a bar painted over the picture. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#80141414" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
