<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/home_tile_gap"
    android:background="@drawable/home_tile_press"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true">

        <FrameLayout
            android:id="@+id/tile_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/home_tile_frame"
            android:duplicateParentState="true"
            android:foreground="@drawable/home_tile_ring"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- filled in the look chosen in Settings -->
            <com.brouken.player.home.FolderPicture
                android:id="@+id/tile_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- amber like the list's star, whatever the accent -->
            <ImageView
                android:id="@+id/tile_star"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/home_tile_badge_round"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_pin_filled_24dp"
                android:tint="@color/rating_amber"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tile_name"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tile_meta"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp" />
</LinearLayout>
