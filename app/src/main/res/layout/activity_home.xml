<?xml version="1.0" encoding="utf-8"?>
<!--
    The screen the application opens on.

    One list, whatever it happens to be showing: the folders, the files inside
    one of them, or what a search turned up. A second screen for each would mean
    a second set of focus rules to get wrong on a remote, and there is nothing
    on any of them that differs except the rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/home_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <!-- Back sits in the bar rather than only under the system gesture, so
             a remote can reach it: a television has a Back key, but nothing on
             screen says a folder can be left. -->
        <ImageButton
            android:id="@+id/home_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/button_back"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_arrow_back_24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/home_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/home_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/home_search_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_search"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_search_24dp" />

        <ImageButton
            android:id="@+id/home_sort_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_sort"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_sort_24dp" />

        <ImageButton
            android:id="@+id/home_network_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_source_url"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_link_24dp" />

        <ImageButton
            android:id="@+id/home_settings_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pref_title"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_settings_24dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <!-- Why the list is empty, which is never obvious: no permission, no
             files, or a search that matched none of them. -->
        <TextView
            android:id="@+id/home_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/home_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:layout_marginTop="96dp"
            android:text="@string/home_grant"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/home_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
