<?xml version="1.0" encoding="utf-8"?>
<!-- The skip button.

     Bottom-right, above the controls, so it never sits under the seek bar. It
     IS focusable, unlike the info card: on a television it has to be reachable
     with the remote, and it is the only thing on screen competing for focus
     while it is visible. -->
<Button xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/online_skip"
    style="?android:attr/buttonStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="96dp"
    android:background="@drawable/online_skip_background"
    android:focusable="true"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp"
    android:textAllCaps="false"
    android:textColor="@color/white"
    android:textSize="15sp"
    android:visibility="gone" />
