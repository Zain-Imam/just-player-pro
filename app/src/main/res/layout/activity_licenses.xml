<?xml version="1.0" encoding="utf-8"?>
<!--
    The list and the text occupy the same space, one at a time, rather than
    being two screens. A licence is long and a remote has to be able to scroll
    it, so the text sits in its own ScrollView that can take the focus.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ListView
        android:id="@+id/licenses_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <ScrollView
        android:id="@+id/licenses_text_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/licenses_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </ScrollView>

</FrameLayout>
