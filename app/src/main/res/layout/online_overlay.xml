<?xml version="1.0" encoding="utf-8"?>
<!-- The card shown while paused.

     Full width and vertically centred, so it reads the same way on a phone in
     either orientation, on a tablet, and across a television. The root is sized
     to the picture itself by OverlayCard, so "full width" here means the width of
     the video rather than of the window: on a letterboxed film the card stops
     exactly where the picture stops. The height is whatever the text needs, so
     rotating re-measures it instead of clipping it.

     Deliberately not interactive: no focusable or clickable children, so on a
     television it cannot swallow a D-pad press meant for the controls, and a
     touch anywhere on it still reaches the player underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/online_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/online_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/online_overlay_card"
        android:clickable="false"
        android:focusable="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/overlay_poster"
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:background="@drawable/online_poster_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlay_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/rating_amber"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/overlay_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="4"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#F2FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
