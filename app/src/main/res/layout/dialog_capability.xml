<?xml version="1.0" encoding="utf-8"?>
<!--
  The body of the warning about a file this device may not manage.

  A dialog message and a checkbox, because the message has to be read and the
  checkbox has to be seen while reading it: an AlertDialog will take one or the
  other, not both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/capability_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="?android:attr/textColorSecondary" />

    <CheckBox
        android:id="@+id/capability_dont_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/capability_dont_warn" />

</LinearLayout>
