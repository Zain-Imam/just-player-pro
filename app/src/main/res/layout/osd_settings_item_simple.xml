<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="@dimen/osd_settings_item_min_width"
    android:minHeight="@dimen/osd_settings_item_min_height"
    android:orientation="horizontal">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp" />

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:elegantTextHeight="true"
        android:textColor="@color/osd_settings_item_title_text"
        android:textSize="@dimen/osd_settings_item_title_text_size" />

    <!--
         Pushes anything after it to the far end. The title keeps wrap_content
         so it is still measured by its own text, which is what sets the panel
         width; giving the title the weight instead would stretch it and change
         how wide every panel opens.
    -->
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!--
         The second verb, where a row has one. Its own target, focusable in its
         own right so a remote can reach it, and gone entirely when unused.
    -->
    <ImageView
        android:id="@+id/osd_trailing_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</LinearLayout>
