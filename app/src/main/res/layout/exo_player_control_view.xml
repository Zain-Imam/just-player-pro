<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <FrameLayout android:id="@+id/exo_controls_background"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center"
      android:layoutDirection="ltr">
  </FrameLayout>

  <FrameLayout android:id="@+id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_bottom_bar_height"
      android:layout_marginTop="@dimen/exo_styled_bottom_bar_margin_top"
      android:layout_gravity="bottom"
      android:background="@color/exo_bottom_bar_background"
      android:layoutDirection="ltr">

    <!-- The time row and the button strip share one LINE rather than being two
         overlapping children of the frame.

         As overlapping children the strip sat on top of the time row and ate
         every touch inside it: in portrait there is not enough width for both,
         so play/pause and the clock stopped responding while looking perfectly
         normal. In a row the strip gets whatever width is left and scrolls
         inside it, so nothing is ever unreachable at any screen size.

         The frame is kept because the extra-controls scroller below is MEANT to
         overlap — it replaces the strip in the player library's overflow mode. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="ltr">

      <LinearLayout android:id="@+id/exo_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/exo_styled_bottom_bar_time_padding"
          android:paddingEnd="@dimen/exo_styled_bottom_bar_time_padding"
          android:paddingLeft="@dimen/exo_styled_bottom_bar_time_padding"
          android:paddingRight="@dimen/exo_styled_bottom_bar_time_padding"
          android:gravity="center_vertical"
          android:layoutDirection="ltr">

        <!-- The clock is its own clickable thing rather than the whole row.
             Tapping it toggles remaining against total, and while the row
             carried the click the ripple lit up the play/pause button beside
             it as though that had been pressed. -->
        <LinearLayout android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

          <TextView android:id="@+id/exo_position"
              style="@style/ExoStyledControls.TimeText.Position"/>

          <TextView
              style="@style/ExoStyledControls.TimeText.Separator"/>

          <TextView android:id="@+id/exo_duration"
              style="@style/ExoStyledControls.TimeText.Duration"/>

        </LinearLayout>

      </LinearLayout>

      <!-- The strip scrolls, because in portrait it does not fit.

           Eight buttons at the smallest size a finger can be asked to hit is
           more width than a phone held upright has left once the clock has had
           its share, so four of them, settings and the padlock among them,
           were simply cut off the end of the screen with nothing to say they
           were there. Shrinking them was not an option: they are already at the
           minimum a touch target may be.

           So it scrolls, with a fading edge to say so. In landscape everything
           fits, the fade never appears, and fillViewport with the end gravity
           below keeps the buttons hard against the right exactly as before. -->
      <HorizontalScrollView
          android:id="@+id/basic_controls_scroll"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:fillViewport="true"
          android:scrollbars="none"
          android:requiresFadingEdge="horizontal"
          android:fadingEdgeLength="24dp"
          android:layoutDirection="ltr">

      <LinearLayout android:id="@+id/exo_basic_controls"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="end|center_vertical"
          android:layoutDirection="ltr">

        <ImageButton android:id="@+id/exo_vr"
            style="@style/ExoStyledControls.Button.Bottom.VR"/>

        <ImageButton android:id="@+id/exo_shuffle"
            style="@style/ExoStyledControls.Button.Bottom.Shuffle"/>

        <ImageButton android:id="@+id/exo_repeat_toggle"
            style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"/>

        <ImageButton android:id="@+id/exo_subtitle"
            style="@style/ExoStyledControls.Button.Bottom.CC"/>

        <ImageButton android:id="@+id/audio_track"
            style="@style/ExoStyledControls.Button.Bottom"
            android:src="@drawable/ic_audio_track_24dp"
            android:contentDescription="@string/audio_menu_title"/>

        <ImageButton android:id="@+id/exo_settings"
            style="@style/ExoStyledControls.Button.Bottom.Settings"/>

        <ImageButton android:id="@+id/exo_fullscreen"
            style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

        <ImageButton android:id="@+id/exo_overflow_show"
            style="@style/ExoStyledControls.Button.Bottom.OverflowShow"/>

      </LinearLayout>
      </HorizontalScrollView>

    </LinearLayout>

    <HorizontalScrollView android:id="@+id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:visibility="invisible">

      <LinearLayout android:id="@+id/exo_extra_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layoutDirection="ltr">

        <ImageButton android:id="@+id/exo_overflow_hide"
            style="@style/ExoStyledControls.Button.Bottom.OverflowHide"/>

      </LinearLayout>

    </HorizontalScrollView>

  </FrameLayout>

  <com.brouken.player.CustomDefaultTimeBar android:id="@+id/exo_progress"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_progress_layout_height"
      android:layout_gravity="bottom"
      android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom"
      app:bar_height="@dimen/exo_styled_progress_bar_height"
      app:bar_gravity="bottom"
      app:touch_target_height="@dimen/exo_styled_progress_touch_target_height"
      app:scrubber_enabled_size="@dimen/exo_styled_progress_enabled_thumb_size"
      app:scrubber_dragged_size="@dimen/exo_styled_progress_dragged_thumb_size"
      app:ad_marker_width="@dimen/marker_width"
      app:played_color="?attr/accentColor"
      app:scrubber_color="?attr/accentColor"
      app:buffered_color="@color/time_bar_buffered"
      app:unplayed_color="@color/time_bar_unplayed"/>

  <LinearLayout android:id="@+id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/exo_styled_minimal_controls_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <ImageButton android:id="@+id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

  </LinearLayout>

  <!--
       Play/pause is anchored to the middle of the screen, not to the middle of
       whatever buttons happen to be on show.

       This was one centred row of buttons, and what is in that row changes:
       delete appears as a film ends, previous and next come and go with the
       folder the film was opened from. Centring the row meant centring
       whatever it currently held, so the play button wandered, and because
       delete reserved its space on the left even while invisible, with next
       and previous both showing the whole group sat a button's width right of
       centre. In portrait, where there is no picture either side to hide it,
       it looked like the controls had slipped off the middle of the screen.

       Two equal halves either side of the play button fix that for every
       combination: the halves are the same width whatever is in them, each
       packs its buttons against the middle, and anything hidden is GONE and
       costs nothing. The play button cannot move.
  -->
  <LinearLayout
      android:id="@+id/exo_center_controls"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:orientation="horizontal"
      android:padding="@dimen/exo_styled_controls_padding">

    <LinearLayout
        android:id="@+id/center_controls_before"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

      <ImageButton android:id="@+id/delete"
          style="@style/ExoStyledControls.Button.Center.Secondary"
          android:src="@drawable/exo_styled_controls_delete"/>

      <!--
           The file before this one in the folder it came from.

           Its own button rather than exo_prev beside it: the player library's
           previous and next move between items in a playlist, and this player
           holds one item at a time and opens a different file instead. Driving
           those two would mean fighting what they are for.

           Placed opposite @id/next, so the pair sit either side of the play
           button the way they do in every other player.
      -->
      <ImageButton android:id="@+id/prev"
          style="@style/ExoStyledControls.Button.Center.Secondary"
          android:src="@drawable/exo_styled_controls_previous"/>

      <ImageButton android:id="@+id/exo_prev"
          style="@style/ExoStyledControls.Button.Center.Previous"/>

      <include layout="@layout/exo_player_control_rewind_button" />

    </LinearLayout>

    <ImageButton android:id="@+id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"/>

    <!--
         The spinner used to sit here, in this row, sharing the slot with the
         play button. Which meant it belonged to the controls: hiding them with
         Back, or letting them time out, took the spinner away too — so a film
         that had not finished buffering sat on a still picture with nothing at
         all to say it was still working. It lives in exo_player_view.xml now,
         outside the controller, where only playback state decides it.
    -->

    <LinearLayout
        android:id="@+id/center_controls_after"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

      <include layout="@layout/exo_player_control_ffwd_button" />

      <ImageButton android:id="@+id/exo_next"
          style="@style/ExoStyledControls.Button.Center.Next"/>

      <ImageButton android:id="@+id/next"
          style="@style/ExoStyledControls.Button.Center.Secondary"
          android:src="@drawable/exo_styled_controls_next"/>

    </LinearLayout>

  </LinearLayout>

  <View android:id="@+id/exo_top"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:background="@color/exo_black_opacity_70"
      android:layout_gravity="top" />

  <View android:id="@+id/exo_left"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:background="@color/exo_black_opacity_70"
    android:layout_gravity="left" />

  <View android:id="@+id/exo_right"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:background="@color/exo_black_opacity_70"
      android:layout_gravity="right" />

    <LinearLayout
        android:id="@+id/exo_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent">
        <View
            android:id="@+id/exo_media_route_button_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
    </LinearLayout>

</merge>
